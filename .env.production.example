# Variáveis da stack de produção (cadastrar no Portainer / GitHub Environments). NÃO commitar valores reais.
IMAGE_APP=ghcr.io/juventudeilhacompridasp-cmyk/overlays-v2/app:main
IMAGE_NGINX=ghcr.io/juventudeilhacompridasp-cmyk/overlays-v2/nginx:main
IMAGE_BACKUP=ghcr.io/juventudeilhacompridasp-cmyk/overlays-v2/backup:main

APP_NAME=Plataforma
APP_URL=https://exemplo.com.br
APP_KEY=                      # php artisan key:generate --show

# Segurança (docs/17-seguranca.md). Os padrões da stack já são os seguros; só mude sabendo o que faz.
# Primeiro administrador: `docker exec -it <app> php artisan platform:create-admin voce@exemplo.com.br --platform`
ALLOW_FIRST_USER_SETUP=false
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
# Proxies confiáveis para X-Forwarded-* (vazio = só rede privada/Docker). NÃO use * com o app alcançável por fora.
TRUSTED_PROXIES=
HSTS_SECONDS=15552000
# Cloudflare Tunnel (perfil `tunnel`): token do túnel criado no painel Zero Trust. Secreto.
CLOUDFLARE_TUNNEL_TOKEN=

DB_DATABASE=overlays
DB_USERNAME=overlays
DB_PASSWORD=
PGDATA_PATH=/srv/data/postgres

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Endereço PÚBLICO do WebSocket (o do proxy, com "Websockets Support"): ex. ws.exemplo.com.br na 443 em https.
REVERB_PUBLIC_HOST=ws.exemplo.com.br
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# Status page (opcional): disco que recebe o retrato estático status/status.json a cada minuto (contingência se a aplicação cair).
# Deixe vazio para só servir a página pela aplicação. Ex.: s3
STATUS_PUBLISH_DISK=
# Avisos de incidente por e-mail aos inscritos da status page (true/false).
STATUS_NOTIFY=true

# Limites de segurança (requisições por minuto por IP; validade em minutos dos links assinados). Padrões abaixo.
PLATFORM_LIMIT_API=60
PLATFORM_LIMIT_OVERLAY=120
PLATFORM_LIMIT_EMBED=120
PLATFORM_LIMIT_PUSH=30
PUSH_RETENTION_DAYS=1
HELP_AI_USER_DAILY=10
HELP_AI_MONTHLY=300
PORTAL_DEFAULT_COLOR="#059669"
IMAGE_MAX_PIXELS=40000000
PLATFORM_LIMIT_CARD=30
PLATFORM_LIMIT_PUBLIC=60
PLATFORM_LIMIT_REGISTRATION=10
SIGNED_URL_DOCUMENTS_MINUTES=10
SIGNED_URL_PHOTOS_MINUTES=30

# Landing page do produto (opcional). O formulário de /produto avisa este e-mail a cada contato (vazio = só guarda na lista).
PLATFORM_CONTACT_EMAIL=
# true = a raiz do domínio-base (e do www) mostra a landing em vez do portal da organização padrão.
PLATFORM_LANDING_ROOT=false
# Hosts da landing separados por vírgula (vazio = domínio-base e www). Ex.: exemplo.com.br,www.exemplo.com.br
PLATFORM_LANDING_HOSTS=
# Medição anônima de acessos da landing (só com consentimento no navegador). false = sem aviso e sem coleta.
PLATFORM_LANDING_ANALYTICS=true

# Avisos push (opcional). Gere o par com `docker compose exec app php artisan webpush:keys`; a privada é segredo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com.br

# Leitura de súmulas por IA (recurso sob demanda `sheet_import`); sem a chave só a leitura de CSV/XLSX funciona
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Limites de custo da leitura por IA (opcionais): leituras por jogo (teto 10) e por organização por mês
SHEET_IMPORT_MAX_READS_PER_GAME=3
SHEET_IMPORT_MONTHLY_READS=200
MARKET_DAILY_REQUESTS=10
MARKET_REQUEST_DAYS=14

# Organizações por subdomínio (opcional): {slug}.PLATFORM_BASE_DOMAIN, com DNS curinga e certificado curinga no proxy.
PLATFORM_BASE_DOMAIN=
DEFAULT_ORGANIZATION_SLUG=default
# Chave do hash do CPF (LGPD). Se vazia usa a APP_KEY; defina uma e NUNCA troque (invalidaria a busca por CPF).
DOCUMENT_HASH_KEY=

# E-mail (convites, avisos aos gestores, inscrição). MAIL_MAILER=log só registra no log.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@exemplo.com.br

# Arquivos enviados (escudos, fotos, documentos, súmulas).
# local = disco do próprio servidor (volume `storage` da stack: storage/app/uploads/public e /private). O público sai em
# APP_URL/files (nginx) e o privado só por link assinado da aplicação. s3 = bucket S3/R2 (preencha AWS_*).
STORAGE_DRIVER=local
FILESYSTEM_DISK=local
# Opcionais com STORAGE_DRIVER=local (padrão: APP_URL/files e APP_URL/private-files)
FILES_PUBLIC_URL=
FILES_PRIVATE_URL=

# Só com STORAGE_DRIVER=s3 (Cloudflare R2 ou S3). R2: AWS_DEFAULT_REGION=auto e AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_URL=

# Backup (banco + arquivos enviados). Padrão: pastas do próprio servidor, em BACKUP_PATH (/srv/data/backups). Para enviar a
# outro lugar (recomendado, o backup no mesmo disco não protege contra perda do servidor) use um remoto do rclone e preencha BACKUP_*.
BACKUP_PATH=/srv/data/backups
BACKUP_REMOTE=/backups/pg
BACKUP_FILES_REMOTE=/backups/files
# Exemplo com R2: BACKUP_REMOTE=r2:nome-do-bucket-backup/pg  BACKUP_FILES_REMOTE=r2:nome-do-bucket-backup/files
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=
