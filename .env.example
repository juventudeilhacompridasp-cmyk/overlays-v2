APP_NAME=Plataforma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=overlays
DB_USERNAME=overlays
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@plataforma.test"
MAIL_FROM_NAME="${APP_NAME}"

# Arquivos: S3 local (Adobe S3Mock, credenciais ignoradas). Em produção: Cloudflare R2 / S3.
AWS_ACCESS_KEY_ID=local-key
AWS_SECRET_ACCESS_KEY=local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=overlays-public
AWS_PRIVATE_BUCKET=overlays-private
AWS_ENDPOINT=http://s3:9090
AWS_URL=http://localhost:9000/overlays-public
AWS_USE_PATH_STYLE_ENDPOINT=true

# Tempo real (Reverb). O servidor Laravel fala com o container "reverb";
# o navegador conecta em localhost:8081.
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Endereço do Reverb visto pelo navegador (em produção: ws.seudominio.com, 443, https)
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8081
REVERB_PUBLIC_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Inertia SSR (desligado em dev; ligado em produção)
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

OPEN_REGISTRATION=false

# Subdomínios das organizações: {slug}.PLATFORM_BASE_DOMAIN (vazio = desligado)
PLATFORM_BASE_DOMAIN=

# Avisos push (gol/início/fim de jogo): gere o par com `php artisan webpush:keys`. Sem as chaves o recurso fica desligado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com
